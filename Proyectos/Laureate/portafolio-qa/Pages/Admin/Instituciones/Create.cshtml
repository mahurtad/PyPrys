@page
@model PortafolioQA.Pages.Admin.Instituciones.CreateModel
@{
    ViewData["Title"] = "Nueva institución";
}

<h1 class="h3 mb-3">Nueva institución</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Institucion.Nombre" class="form-label"></label>
                <input asp-for="Institucion.Nombre" class="form-control" />
                <span asp-validation-for="Institucion.Nombre" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Institucion.Activo" class="form-check-input" />
                <label asp-for="Institucion.Activo" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
