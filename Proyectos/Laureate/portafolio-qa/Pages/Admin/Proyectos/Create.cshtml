@page
@model PortafolioQA.Pages.Admin.Proyectos.CreateModel
@{
    ViewData["PuedeForzar"] = Model.PuedeForzar;
    ViewData["Title"] = "Nuevo proyecto";
    ViewData["Instituciones"] = Model.Instituciones;
    ViewData["Sistemas"] = Model.Sistemas;
    ViewData["SistemasSeleccionados"] = Model.SistemasSeleccionados;
}

<h1 class="h3 mb-3">Nuevo proyecto</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <partial name="_Form" for="Proyecto" />

            <div class="mb-3">
                <label class="form-label mb-1">Recursos QA asignados</label>
                <div class="form-text mt-0 mb-2">Se asignan con las fechas del proyecto. Puedes ajustarlas después desde Asignaciones.</div>
                <span asp-validation-for="AsignacionesIniciales" class="text-danger d-block"></span>
                <div id="filas-asignacion">
                    @for (var i = 0; i < Model.AsignacionesIniciales.Count; i++)
                    {
                        var a = Model.AsignacionesIniciales[i];
                        <div class="row g-2 mb-2 fila-asignacion">
                            <div class="col-md-5">
                                <select name="AsignacionesIniciales[@i].RecursoQAId" class="form-select form-select-sm">
                                    <option value="0">Selecciona un recurso QA</option>
                                    @foreach (var r in Model.Recursos)
                                    {
                                        <option value="@r.Id" selected="@(r.Id == a.RecursoQAId)">@r.NombreCompleto</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4"><input name="AsignacionesIniciales[@i].Rol" class="form-control form-control-sm" value="@a.Rol" placeholder="Rol" maxlength="100" /></div>
                            <div class="col-md-2">
                                <div class="input-group input-group-sm">
                                    <input name="AsignacionesIniciales[@i].Porcentaje" type="number" step="0.01" min="0.01" max="100" class="form-control" value="@a.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-1"><button type="button" class="btn btn-sm btn-outline-danger quitar-asignacion" title="Quitar">&times;</button></div>
                        </div>
                    }
                </div>
                <button type="button" id="agregar-asignacion" class="btn btn-sm btn-outline-primary">+ Agregar recurso QA</button>
            </div>

            <template id="plantilla-asignacion">
                <div class="row g-2 mb-2 fila-asignacion">
                    <div class="col-md-5">
                        <select name="AsignacionesIniciales[__i__].RecursoQAId" class="form-select form-select-sm">
                            <option value="0">Selecciona un recurso QA</option>
                            @foreach (var r in Model.Recursos)
                            {
                                <option value="@r.Id">@r.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4"><input name="AsignacionesIniciales[__i__].Rol" class="form-control form-control-sm" value="Analista QA" placeholder="Rol" maxlength="100" /></div>
                    <div class="col-md-2">
                        <div class="input-group input-group-sm">
                            <input name="AsignacionesIniciales[__i__].Porcentaje" type="number" step="0.01" min="0.01" max="100" class="form-control" value="100" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-1"><button type="button" class="btn btn-sm btn-outline-danger quitar-asignacion" title="Quitar">&times;</button></div>
                </div>
            </template>

            <partial name="_ConflictosCapacidad" model="Model.Conflictos" />
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var contenedor = document.getElementById('filas-asignacion');
            var plantilla = document.getElementById('plantilla-asignacion');

            // Mantiene índices contiguos (0..n-1) para que MVC enlace la lista correctamente.
            function renumerar() {
                contenedor.querySelectorAll('.fila-asignacion').forEach(function (fila, i) {
                    fila.querySelectorAll('[name^="AsignacionesIniciales["]').forEach(function (campo) {
                        campo.name = campo.name.replace(/AsignacionesIniciales\[[^\]]*\]/, 'AsignacionesIniciales[' + i + ']');
                    });
                });
            }

            document.getElementById('agregar-asignacion').addEventListener('click', function () {
                contenedor.insertAdjacentHTML('beforeend', plantilla.innerHTML.replace(/__i__/g, '0'));
                renumerar();
            });
            contenedor.addEventListener('click', function (e) {
                var boton = e.target.closest('.quitar-asignacion');
                if (!boton) return;
                boton.closest('.fila-asignacion').remove();
                renumerar();
            });
        })();
    </script>
}
