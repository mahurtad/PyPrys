@using Microsoft.AspNetCore.Mvc.Rendering
@model PortafolioQA.Models.Proyecto
@{
    var instituciones = (List<PortafolioQA.Models.Institucion>)ViewData["Instituciones"]!;
    var sistemas = (List<PortafolioQA.Models.Sistema>)ViewData["Sistemas"]!;
    var sistemasSeleccionados = (List<int>)ViewData["SistemasSeleccionados"]!;
    var recursosQA = ViewData["QAAsignados"] as List<string>;
    var colPm = recursosQA is null ? "col-md-6" : "col-md-4";
    var squashProyectos = ViewData["SquashProyectos"] as List<PortafolioQA.Services.Integrations.SquashProyectoDto> ?? new();
    var squashError = ViewData["SquashError"] as string;
    var puedeManual = ViewData["SquashPuedeManual"] as bool? ?? false;
    var esAlta = Model.Id == 0;
    var vinculado = Model.SquashProjectId is not null;
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" readonly="@(vinculado || (esAlta && !puedeManual))" />
    @if (vinculado)
    {
        <div class="form-text">El nombre es el del proyecto en Squash TM y se actualiza con cada sincronización.</div>
    }
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="InstitucionId" class="form-label"></label>
        <select asp-for="InstitucionId" class="form-select" asp-items="@(new SelectList(instituciones, "Id", "Nombre"))">
            <option value="">Selecciona una institución</option>
        </select>
        <span asp-validation-for="InstitucionId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList<PortafolioQA.Models.TipoIniciativa>()"></select>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label">Estado</label>
        <div><span class="badge @Model.Estado.BadgeClase()">@Model.Estado.Texto()</span></div>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Avance</label>
        <div class="progress" role="progressbar" aria-valuenow="@Model.Avance" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width:@Model.Avance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;@(Model.Avance > 0 ? "min-width:3rem" : "")">@Model.Avance.ToString("0.#")%</div>
        </div>
        <div class="form-text">Se calcula a partir del avance de las actividades no canceladas.</div>
    </div>
</div>

<div class="row">
    <div class="@colPm mb-3">
        <label asp-for="BPO" class="form-label"></label>
        <input asp-for="BPO" class="form-control" />
    </div>
    <div class="@colPm mb-3">
        <label asp-for="PM" class="form-label"></label>
        <input asp-for="PM" class="form-control" />
    </div>
    <div class="@colPm mb-3">
        <label asp-for="Lider" class="form-label"></label>
        <input asp-for="Lider" class="form-control" />
    </div>
    @if (recursosQA is not null)
    {
        <div class="@colPm mb-3">
            <label class="form-label">QA asignado</label>
            <div class="form-control h-auto" style="min-height:38px;background-color:#e9ecef">
                @if (recursosQA.Any())
                {
                    @foreach (var r in recursosQA)
                    {
                        <span class="badge bg-light text-dark border me-1">@r</span>
                    }
                }
                else
                {
                    <span class="text-muted">Sin asignar</span>
                }
            </div>
            <div class="form-text">Se toma de <a asp-page="/Portafolio/Detalle" asp-route-id="@Model.Id" asp-fragment="equipo">Equipo y planificación</a>.</div>
        </div>
    }
</div>

<div class="mb-3">
    <label asp-for="SquashProjectId" class="form-label"></label>
    <select asp-for="SquashProjectId" class="form-select" required="@(esAlta && !puedeManual)" data-bloquea-sin-vinculo="@((esAlta && !puedeManual) ? "true" : "false")">
        @if (esAlta && puedeManual)
        {
            <option value="">Sin Squash (manual): solo si el proyecto no existe en Squash TM</option>
        }
        else if (esAlta)
        {
            <option value="">Selecciona un proyecto de Squash TM…</option>
        }
        else if (!vinculado)
        {
            <option value="">Sin vincular (avance manual por actividades)</option>
        }
        else if (puedeManual)
        {
            <option value="">Desvincular de Squash TM (avance manual)</option>
        }
        @foreach (var sp in squashProyectos)
        {
            <option value="@sp.Id" selected="@(sp.Id == Model.SquashProjectId)">@sp.Nombre</option>
        }
        @if (Model.SquashProjectId is not null && squashProyectos.All(x => x.Id != Model.SquashProjectId))
        {
            <option value="@Model.SquashProjectId" selected>Proyecto @Model.SquashProjectId de Squash TM</option>
        }
    </select>
    @if (squashError is not null)
    {
        <div class="form-text text-warning">No se pudo leer la lista de Squash TM: @squashError</div>
    }
    else
    {
        <div class="form-text">
            Solo se listan los proyectos de Squash TM que aún no están en el portafolio. Al elegir uno, el nombre se toma de Squash y el avance sale de la ejecución de pruebas.
            @if (esAlta && puedeManual) { <text> Crear sin Squash solo corresponde si el proyecto no existe allí.</text> }
        </div>
    }
    <span asp-validation-for="SquashProjectId" class="text-danger"></span>

</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="FechaInicio" class="form-label"></label>
        <input asp-for="FechaInicio" class="form-control" type="date" />
        <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="FechaFin" class="form-label"></label>
        <input asp-for="FechaFin" class="form-control" type="date" />
        <span asp-validation-for="FechaFin" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Sistemas / periféricos impactados</label>
    @if (!sistemas.Any())
    {
        <p class="text-muted">No hay sistemas activos registrados.</p>
    }
    else
    {
        @foreach (var s in sistemas)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SistemasSeleccionados" value="@s.Id" id="sis-@s.Id"
                       checked="@sistemasSeleccionados.Contains(s.Id)" />
                <label class="form-check-label" for="sis-@s.Id">@s.Nombre</label>
            </div>
        }
    }
</div>

<div class="form-check mb-3">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
</div>

<script>
    // Al elegir un proyecto de Squash el nombre se toma de la lista y queda de solo lectura; sin vínculo (solo administrador) se escribe a mano.
    (function () {
        var sel = document.querySelector('[name="Proyecto.SquashProjectId"]');
        var nom = document.querySelector('[name="Proyecto.Nombre"]');
        if (!sel || !nom) return;
        sel.addEventListener('change', function () {
            if (sel.value) { nom.value = sel.options[sel.selectedIndex].text; nom.readOnly = true; }
            else {
                var bloquea = sel.dataset.bloqueaSinVinculo === 'true';
                nom.readOnly = bloquea;
                if (bloquea) nom.value = '';
            }
        });
    })();
</script>

