@page
@model PortafolioQA.Pages.Admin.RecursosQA.CreateModel
@{
    ViewData["Usuarios"] = Model.Usuarios;
    ViewData["Title"] = "Nuevo recurso QA";
}

<h1 class="h3 mb-3">Nuevo recurso QA</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <partial name="_Form" for="Recurso" />
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
