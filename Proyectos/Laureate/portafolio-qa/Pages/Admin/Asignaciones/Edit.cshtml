@page "{id:int}"
@model PortafolioQA.Pages.Admin.Asignaciones.EditModel
@{
    ViewData["PuedeForzar"] = Model.PuedeForzar;
    ViewData["Title"] = "Editar asignación";
    ViewData["Proyectos"] = Model.Proyectos;
    ViewData["Recursos"] = Model.Recursos;
}

<h1 class="h3 mb-3">Editar asignación</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Asignacion.Id" />
            <partial name="_Form" for="Asignacion" />
            <partial name="_ConflictosCapacidad" model="Model.Conflictos" />
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
