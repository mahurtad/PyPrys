@page
@model PortafolioQA.Pages.Admin.Asignaciones.IndexModel
@{
    ViewData["Title"] = "Asignaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Asignaciones</h1>
    <a asp-page="Create" class="btn btn-primary">Nueva asignación</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (!Model.Asignaciones.Any())
{
    <div class="alert alert-info">No hay asignaciones registradas todavía.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Proyecto</th>
                <th>Recurso QA</th>
                <th>Rol</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Dedicación</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Asignaciones)
            {
                <tr>
                    <td>@a.Proyecto?.Nombre</td>
                    <td>@a.RecursoQA?.NombreCompleto</td>
                    <td>@a.Rol</td>
                    <td>@a.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@a.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>@a.Porcentaje%</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-page="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
