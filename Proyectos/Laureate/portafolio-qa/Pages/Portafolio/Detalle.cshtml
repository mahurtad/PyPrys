@page "{id:int}"
@model PortafolioQA.Pages.Portafolio.DetalleModel
@{
    ViewData["Title"] = Model.Proyecto.Nombre;
    var puedeEditar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Editor);
    var equipoEditable = puedeEditar && Model.Proyecto.Estado != EstadoProyecto.Cerrado;
}

@if (Model.Proyecto.AvancePendienteConfirmar)
{
    <div class="alert alert-warning">Avance por confirmar. Se conserva el avance heredado de @Model.Proyecto.AvanceLegado % hasta la confirmación del PM.</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Proyecto.Nombre</h1>
    </div>
    <div class="text-end">
        <span class="badge @Model.Proyecto.Estado.BadgeClase() fs-6">@Model.Proyecto.Estado.Texto()</span>
        <div class="mt-2">
            @if (puedeEditar)
            {
                <a asp-page="/Admin/Proyectos/Edit" asp-route-id="@Model.Proyecto.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Datos del Proyecto</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Tipo</dt>
                    <dd class="col-sm-8">@Model.Proyecto.Tipo.Texto()</dd>
                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@(Model.Proyecto.Descripcion ?? "—")</dd>
                    <dt class="col-sm-4">Institución</dt>
                    <dd class="col-sm-8">@(Model.Proyecto.Institucion?.Nombre ?? "—")</dd>
                    <dt class="col-sm-4">BPO</dt>
                    <dd class="col-sm-8">@(Model.Proyecto.BPO ?? "—")</dd>
                    <dt class="col-sm-4">PM</dt>
                    <dd class="col-sm-8">@(Model.Proyecto.PM ?? "—")</dd>
                    <dt class="col-sm-4">Líder</dt>
                    <dd class="col-sm-8">@(Model.Proyecto.Lider ?? "—")</dd>
                    <dt class="col-sm-4">Periodo</dt>
                    <dd class="col-sm-8">@Model.Proyecto.FechaInicio.ToString("dd/MM/yyyy") – @Model.Proyecto.FechaFin.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Status de Certificación</div>
            <div class="card-body">
                @if (Model.Proyecto.SquashProjectId is null)
                {
                    <p class="text-muted mb-0">El proyecto no está vinculado a Squash TM; no hay casos de certificación que mostrar.</p>
                }
                else
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Total de casos</dt>
                        <dd class="col-sm-7">@Model.Status.Total</dd>
                        <dt class="col-sm-5">Ejecutados</dt>
                        <dd class="col-sm-7">@Model.Status.Ejecutados</dd>
                        <dt class="col-sm-5">Fallidos</dt>
                        <dd class="col-sm-7">@Model.Status.Fallidos</dd>
                    </dl>
                    <hr class="my-3" />
                    <h3 class="h5 mb-2">Defectos <span class="text-secondary fw-normal small">(Bugzilla)</span></h3>
                    @if (Model.Resumen is { } r)
                    {
                        <dl class="row mb-2">
                            <dt class="col-sm-5">Total de defectos</dt>
                            <dd class="col-sm-7">@r.Total</dd>
                            <dt class="col-sm-5">Defectos abiertos</dt>
                            <dd class="col-sm-7">@r.Abiertos</dd>
                        </dl>
                        <div class="d-flex flex-wrap gap-1">
                            <span class="tag-defecto tag-bloqueante">Bloqueantes <b>@r.Bloqueantes</b></span>
                            <span class="tag-defecto tag-nobloqueante">No bloqueantes <b>@r.NoBloqueantes</b></span>
                            <span class="tag-defecto tag-mejora">Mejora <b>@r.Mejoras</b></span>
                            @if (r.SinClasificar > 0)
                            {
                                <span class="tag-defecto tag-sinclasificar" title="Abiertos con otra severidad">Sin clasificar <b>@r.SinClasificar</b></span>
                            }
                            <span class="tag-defecto tag-retest" title="RESOLVED + FIXED">Pendiente de retest <b>@r.PendienteRetest</b></span>
                        </div>
                        <div class="small text-secondary mt-2">Severidad solo sobre los defectos abiertos (estado distinto de RESOLVED, VERIFIED y CLOSED).</div>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">Sin datos disponibles.</p>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-12" id="equipo">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Equipo y planificación</span>
                @if (equipoEditable)
                {
                    <a asp-page="/Admin/Asignaciones/Create" asp-route-proyectoId="@Model.Proyecto.Id" class="btn btn-sm btn-outline-primary">Agregar asignación</a>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.Proyecto.Asignaciones.Any())
                {
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Recurso QA</th>
                                <th>Equipo</th>
                                <th>Rol</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Dedicación</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Proyecto.Asignaciones.OrderBy(a => a.FechaInicio))
                            {
                                <tr>
                                    <td>@a.RecursoQA?.NombreCompleto @if (a.NoEjecutada) { <span class="badge bg-secondary" title="El proyecto cerró antes de que empezara">No ejecutada</span> }</td>
                                    <td>@a.RecursoQA?.Equipo.Texto()</td>
                                    <td>@a.Rol</td>
                                    <td>@a.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@a.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td>@a.Porcentaje%</td>
                                    <td class="text-nowrap">
                                        @if (equipoEditable)
                                        {
                                            <form method="post" asp-page="/Admin/Asignaciones/Delete" asp-route-id="@a.Id" class="d-inline"
                                                  onsubmit="return confirm('¿Eliminar la asignación de @a.RecursoQA?.NombreCompleto? Se liberará su dedicación en este proyecto.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                            <a asp-page="/Admin/Asignaciones/Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No hay recursos QA asignados a esta iniciativa.</p>
                }
            </div>
        </div>
    </div>

    @if (Model.Proyecto.SquashProjectId is null)
    {
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Actividades</span>
                @if (puedeEditar)
                {
                    <a asp-page="/Admin/Proyectos/Edit" asp-route-id="@Model.Proyecto.Id" asp-fragment="actividades" class="btn btn-sm btn-outline-primary">Gestionar actividades</a>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.Proyecto.Actividades.Any())
                {
                    <table class="table mb-0">
                        <thead><tr><th>Actividad</th><th>Recurso QA</th><th>Inicio</th><th>Fin</th><th>Estado</th><th style="width:180px">Avance</th></tr></thead>
                        <tbody>
                            @foreach (var act in Model.Proyecto.Actividades.OrderBy(x => x.Orden).ThenBy(x => x.FechaInicio).ThenBy(x => x.Nombre))
                            {
                                <tr>
                                    <td>@act.Nombre</td>
                                    <td>@(act.RecursoQA?.NombreCompleto ?? "—")</td>
                                    <td>@act.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@act.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge @act.Estado.BadgeClase()">@act.Estado.Texto()</span></td>
                                    <td>
                                        <div class="progress progress-texto" role="progressbar" aria-valuenow="@act.Avance" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar" style="width:@(act.Avance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;@(act.Avance > 0 ? "min-width:2.5rem" : "")">@(act.Avance.ToString("0.#"))%</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No hay actividades registradas para esta iniciativa.</p>
                }
            </div>
        </div>
    </div>

    }
    else
    {
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Ejecución en Squash TM</span>
                <span class="small text-muted">
                    @(Model.Proyecto.SquashSincronizadoEn is null ? "Sin sincronizar" : "Sincronizado " + Model.Proyecto.SquashSincronizadoEn.Value.ToString("dd/MM/yyyy HH:mm"))
                    @if (puedeEditar)
                    {
                        <form method="post" asp-page-handler="SincronizarSquash" asp-route-id="@Model.Proyecto.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Actualizar</button>
                        </form>
                    }
                </span>
            </div>
            <div class="card-body p-0">
                @{
                    var campanasSquash = Model.Proyecto.SquashCampanas.Where(c => c.Vigente).OrderBy(c => c.SquashId).ToList();
                }
                @if (!campanasSquash.Any())
                {
                    <p class="text-muted p-3 mb-0">Aún no hay datos de Squash TM. Pulsa «Actualizar» para traer las campañas y los casos del proyecto.</p>
                }
                else
                {
                    @foreach (var camp in campanasSquash)
                    {
                        <div class="px-3 pt-3 fw-semibold">Campaña: @camp.Nombre</div>
                        @foreach (var it in camp.Iteraciones.Where(i => i.Vigente).OrderBy(i => i.SquashId))
                        {
                            var casosIt = it.Casos.Where(k => k.Vigente).OrderBy(k => k.SquashItemId).ToList();
                            // Grupos = módulos (suites de Squash, relación real) y "Sin módulo" para los ítems que no están en ninguna suite.
                            var grupos = it.Modulos.Where(m => m.Vigente).OrderBy(m => m.SquashId)
                                .Select(m => (Id: m.Id, Nombre: m.Nombre, Casos: m.Casos.Where(k => k.Vigente && k.SquashIteracionId == it.Id).OrderBy(k => k.SquashItemId).ToList()))
                                .ToList();
                            var sinModulo = casosIt.Where(k => !k.Modulos.Any(m => m.Vigente)).ToList();
                            if (sinModulo.Any()) { grupos.Add((Id: 0, Nombre: "Sin módulo", Casos: sinModulo)); }
                            <div class="px-3 pt-2 d-flex align-items-center gap-2">
                                <strong class="flex-shrink-0">Iteración: @it.Nombre</strong>
                                <div class="progress progress-texto flex-grow-1" role="progressbar" aria-valuenow="@it.Porcentaje" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar" style="width:@(it.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;@(it.Porcentaje > 0 ? "min-width:2.5rem" : "")">@(it.Porcentaje.ToString("0.#"))%</div>
                                </div>
                            </div>
                            @if (!grupos.Any())
                            {
                                <p class="text-muted small px-3 py-2 mb-2">Sin casos en el plan de pruebas.</p>
                            }
                            else
                            {
                            <div class="table-responsive">
                            <table class="table table-sm align-middle mb-2 tabla-modulos">
                                <thead><tr><th>Módulo</th><th class="text-end">Casos</th><th class="text-end">Ejecutados</th><th class="text-end">Pendientes</th><th class="text-end">Avance</th><th><span class="visually-hidden">Detalle</span></th></tr></thead>
                                <tbody>
                                    @foreach (var g in grupos)
                                    {
                                        var ejecutados = g.Casos.Count(k => k.EstadoSquash is "SUCCESS" or "SETTLED" or "FAILURE" or "ERROR" or "WARNING");
                                        var noCuentan = g.Casos.Count(k => k.Porcentaje is null);
                                        var pendientes = g.Casos.Count - ejecutados - noCuentan;
                                        var conPorcentaje = g.Casos.Where(k => k.Porcentaje is not null).ToList();
                                        var avanceModulo = conPorcentaje.Count == 0 ? 0m : Math.Round(conPorcentaje.Average(k => k.Porcentaje!.Value), 1);
                                        var idDetalle = $"modulo-{it.Id}-{g.Id}";
                                        <tr>
                                            <td class="fw-medium">@g.Nombre@if (noCuentan > 0) { <span class="text-secondary small fw-normal" title="No ejecutables, omitidos o cancelados: no cuentan como pendientes ni para el avance"> (@noCuentan sin contar)</span> }</td>
                                            <td class="text-end">@g.Casos.Count</td>
                                            <td class="text-end">@ejecutados</td>
                                            <td class="text-end">@pendientes</td>
                                            <td class="text-end">@avanceModulo.ToString("0.#") %</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#@idDetalle" aria-expanded="false" aria-controls="@idDetalle">Ver casos</button>
                                            </td>
                                        </tr>
                                        <tr class="collapse" id="@idDetalle">
                                            <td colspan="6" class="bg-light p-0">
                                                <div class="table-responsive">
                                                <table class="table table-sm align-middle mb-0">
                                                    <thead><tr><th>Caso de prueba</th><th>Estado en Squash</th><th style="width:90px">Avance</th><th>Asignado</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var caso in g.Casos)
                                                        {
                                                            <tr>
                                                                <td class="ps-4">@caso.Nombre</td>
                                                                <td><span class="badge @PortafolioQA.Services.Integrations.SquashEstados.Badge(caso.EstadoSquash)">@PortafolioQA.Services.Integrations.SquashEstados.Texto(caso.EstadoSquash)</span></td>
                                                                <td>@(caso.Porcentaje is null ? "—" : caso.Porcentaje.Value.ToString("0.#") + "%")</td>
                                                                <td>@(caso.RecursoQA?.NombreCompleto ?? caso.AsignadoLogin ?? "—")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            }
                        }
                        @if (!camp.Iteraciones.Any(i => i.Vigente))
                        {
                            <p class="text-muted small px-3 py-2 mb-2">Sin iteraciones.</p>
                        }
                    }
                }
            </div>
        </div>
    </div>
    }

    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Acuerdos</span>
                @if (puedeEditar)
                {
                    <a asp-page="/Admin/Proyectos/Edit" asp-route-id="@Model.Proyecto.Id" asp-fragment="acuerdos" class="btn btn-sm btn-outline-primary">Gestionar acuerdos</a>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.Proyecto.Acuerdos.Any())
                {
                    <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead><tr><th>ID</th><th>Título</th><th>Responsable</th><th>Fecha del acuerdo</th><th>Fecha límite</th><th>Estado</th><th>Actividades vinculadas</th></tr></thead>
                        <tbody>
                            @foreach (var ac in Model.Proyecto.Acuerdos.OrderBy(x => x.Numero))
                            {
                                <tr>
                                    <td class="text-nowrap">@ac.Codigo</td>
                                    <td>@ac.Titulo</td>
                                    <td>@ac.Responsable</td>
                                    <td class="text-nowrap">@ac.FechaAcuerdo.ToString("dd/MM/yyyy")</td>
                                    <td class="text-nowrap">@ac.FechaLimite.ToString("dd/MM/yyyy") @if (ac.Vencido) { <span class="badge bg-danger">Vencido</span> }</td>
                                    <td><span class="badge @ac.Estado.BadgeClase()">@ac.Estado.Texto()</span></td>
                                    <td>
                                        <span class="badge bg-info text-dark" title="@(ac.Actividades.Any() ? string.Join(", ", ac.Actividades.Select(v => v.Actividad.Nombre).OrderBy(n => n)) : "Sin actividades vinculadas")">@ac.Actividades.Count</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No hay acuerdos registrados para esta iniciativa.</p>
                }
            </div>
        </div>
    </div>

    @* Oculto temporalmente: Certificación (Squash TM)
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Certificación (Squash TM)</span>
                @if (puedeEditar)
                {
                    <a asp-page="/Admin/Integraciones/Create" asp-route-proyectoId="@Model.Proyecto.Id" class="btn btn-sm btn-outline-primary">Asociar fuente externa</a>
                }
            </div>
            <div class="card-body">
                @if (!Model.Certificaciones.Any())
                {
                    <p class="text-muted mb-0">
                        Esta iniciativa no tiene una asociación con Squash TM configurada. El avance de ejecución y los
                        resultados de certificación se mostrarán aquí cuando exista una conexión real (etapa 4).
                    </p>
                }
                else
                {
                    @foreach (var c in Model.Certificaciones)
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="d-flex justify-content-between">
                                <strong>Identificador externo: @c.Fuente.IdentificadorExterno</strong>
                                <span class="badge @c.Fuente.Estado.BadgeClase()">@c.Fuente.Estado.Texto()</span>
                            </div>
                            @if (c.Resultado.Disponible)
                            {
                                <p class="mb-1">Avance de ejecución: @c.Resultado.ElementosEjecutados / @c.Resultado.ElementosPlanificados elementos.</p>
                                <p class="mb-1">Aprobados: @c.Resultado.Aprobados · Fallidos: @c.Resultado.Fallidos · Bloqueados: @c.Resultado.Bloqueados · Pendientes: @c.Resultado.Pendientes</p>
                                @if (c.Resultado.Desactualizado)
                                {
                                    <p class="text-warning mb-0">Dato desactualizado desde @c.Resultado.UltimaActualizacion?.ToString("dd/MM/yyyy HH:mm").</p>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">@c.Resultado.Mensaje</p>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    *@

    @{
        var cierre = Model.Proyecto.Cierres.OrderByDescending(c => c.Fecha).FirstOrDefault();
    }
    @if (Model.Proyecto.Estado == EstadoProyecto.Cerrado && cierre is null)
    {
        <div class="col-12">
            <div class="alert alert-warning mb-0">
                <strong>Sin trazabilidad.</strong> Este proyecto se cerró antes de que el sistema guardara el historial del equipo y de las actividades.
            </div>
        </div>
    }
    @if (cierre is not null)
    {
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Historial de cierre</span>
                    @if (cierre.Vigente)
                    {
                        <span class="badge bg-success">Cierre vigente</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Reabierto el @cierre.FechaReapertura?.ToString("dd/MM/yyyy") por @cierre.UsuarioReapertura</span>
                    }
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        Cerrado el <strong>@cierre.Fecha.ToString("dd/MM/yyyy HH:mm")</strong> por <strong>@cierre.Usuario</strong>
                        con avance final de <strong>@cierre.AvanceFinal.ToString("0.#")%</strong>
                        (@cierre.ActividadesCompletadas de @cierre.TotalActividades actividades completadas).
                    </p>
                    @if (cierre.Reconstruido)
                    {
                        <p class="small text-muted">Registro reconstruido a partir de las asignaciones existentes. Las actividades no conservan su responsable.</p>
                    }
                    <h3 class="h6 mt-3">Equipo que participó</h3>
                    @if (cierre.Participantes.Any())
                    {
                        <table class="table table-sm">
                            <thead><tr><th>Recurso QA</th><th>Rol</th><th>Dedicación</th><th>Periodo</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var pa in cierre.Participantes.OrderByDescending(x => x.Ejecutada).ThenBy(x => x.NombreRecurso))
                                {
                                    <tr>
                                        <td>@pa.NombreRecurso</td>
                                        <td>@pa.Rol</td>
                                        <td>@pa.Porcentaje.ToString("0.#")%</td>
                                        <td>@pa.FechaInicio.ToString("dd/MM/yyyy") – @pa.FechaFin.ToString("dd/MM/yyyy")</td>
                                        <td>@if (!pa.Ejecutada) { <span class="badge bg-secondary">No ejecutada</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted small">No había recursos asignados al cerrar.</p>
                    }
                    <h3 class="h6 mt-3">Actividades al cierre</h3>
                    @if (cierre.Actividades.Any())
                    {
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Actividad</th><th>Responsable</th><th>Estado</th><th>Avance</th></tr></thead>
                            <tbody>
                                @foreach (var ca in cierre.Actividades.OrderBy(x => x.FechaInicio).ThenBy(x => x.Nombre))
                                {
                                    <tr>
                                        <td>@ca.Nombre</td>
                                        <td>@(ca.Responsable ?? "—")</td>
                                        <td>@ca.Estado</td>
                                        <td>@ca.Avance.ToString("0.#")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No había actividades al cerrar.</p>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-12">
        <div class="card">
            <div class="card-header">Sistemas / periféricos impactados</div>
            <div class="card-body">
                @if (Model.Proyecto.Sistemas.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var ps in Model.Proyecto.Sistemas)
                        {
                            <li class="list-group-item">@ps.Sistema.Nombre</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">No se han registrado sistemas impactados.</p>
                }
            </div>
        </div>
    </div>
</div>

<section class="card mt-4" id="bugzilla">
    <div class="card-header">Defectos en Bugzilla</div>
    <div class="card-body">
        @if (Model.Defectos.Count == 0)
        {
            <p class="text-muted mb-0">Sin producto de Bugzilla asociado. Se puede asociar desde Administración → Integraciones.</p>
        }
        @foreach (var consulta in Model.Defectos)
        {
            <h3 class="h6">@consulta.Fuente.IdentificadorExterno</h3>
            @if (!consulta.Resultado.Disponible)
            {
                <p class="text-warning">@consulta.Resultado.Mensaje</p>
            }
            else if (consulta.Resultado.Defectos.Count == 0)
            {
                <p class="text-muted">No se encontraron defectos para este producto.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm">
                    <thead><tr><th>ID</th><th>Título</th><th>Estado</th><th>Severidad</th><th>Responsable</th></tr></thead>
                    <tbody>@foreach (var defecto in consulta.Resultado.Defectos)
                    {
                        <tr><td><a href="@defecto.Url" target="_blank" rel="noopener noreferrer">@defecto.Id</a></td><td>@defecto.Titulo</td><td>@defecto.EstadoTexto @defecto.Resolucion</td><td>@defecto.Severidad</td><td>@defecto.Responsable</td></tr>
                    }</tbody>
                </table></div>
            }
        }
    </div>
</section>
<div class="mt-4">
    <a asp-page="/Portafolio/Index" class="btn btn-outline-secondary">&larr; Volver al portafolio</a>
</div>
