@page
@model PortafolioQA.Pages.Portafolio.IndexModel
@using PortafolioQA.Models
@{
    ViewData["Title"] = "Portafolio";
    // Los filtros secundarios se agrupan en una sección desplegable que queda abierta si alguno tiene un valor activo.
    var secundariosActivos = (Model.RecursoQAId.HasValue ? 1 : 0) + (!string.IsNullOrEmpty(Model.Pm) ? 1 : 0)
        + (!string.IsNullOrEmpty(Model.Lider) ? 1 : 0) + (Model.SistemaId.HasValue ? 1 : 0);
    var hayFiltros = secundariosActivos > 0 || Model.InstitucionId.HasValue || Model.Tipo.HasValue || Model.Estado.HasValue;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Portafolio de Proyectos</h1>
    <div class="btn-group" role="group" aria-label="Cambiar vista">
        <button type="button" id="btn-vista-tarjetas" class="btn btn-outline-primary active" aria-pressed="true">Tarjetas</button>
        <button type="button" id="btn-vista-tabla" class="btn btn-outline-primary" aria-pressed="false">Tabla</button>
    </div>
</div>

@if (!Model.Instituciones.Any())
{
    <div class="alert alert-info">
        No hay instituciones registradas todavía.
        @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Editor))
        {
            <span>Ingresa la primera desde <a asp-page="/Admin/Instituciones/Create">Administración &rarr; Instituciones</a> antes de crear proyectos.</span>
        }
        else
        {
            <span>Solicita a un editor o administrador que las registre.</span>
        }
    </div>
}

<form method="get" class="card mb-3" aria-label="Filtros del portafolio">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="f-institucion">Institución</label>
                <select name="InstitucionId" id="f-institucion" class="form-select" asp-items="@(new SelectList(Model.Instituciones, "Id", "Nombre"))">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="f-tipo">Tipo</label>
                <select name="Tipo" id="f-tipo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var tipo in Enum.GetValues<TipoIniciativa>())
                    {
                        <option value="@tipo" selected="@(Model.Tipo == tipo)">@tipo.Texto()</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="f-estado">Estado</label>
                <select name="Estado" id="f-estado" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var estado in Enum.GetValues<EstadoProyecto>())
                    {
                        <option value="@estado" selected="@(Model.Estado == estado)">@estado.Texto()</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-3 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-page="/Portafolio/Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-link btn-sm p-0 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#filtros-secundarios"
                    aria-expanded="@(secundariosActivos > 0 ? "true" : "false")" aria-controls="filtros-secundarios">
                Más filtros
                @if (secundariosActivos > 0)
                {
                    <span class="badge bg-blue-lt ms-1">@secundariosActivos activo(s)</span>
                }
            </button>
        </div>
        <div class="collapse @(secundariosActivos > 0 ? "show" : "")" id="filtros-secundarios">
            <div class="row g-3 mt-0">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="f-recurso">Recurso QA</label>
                    <select name="RecursoQAId" id="f-recurso" class="form-select" asp-items="@(new SelectList(Model.RecursosQA, "Id", "NombreCompleto"))">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="f-pm">PM</label>
                    <select name="Pm" id="f-pm" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var pm in Model.Pms)
                        {
                            <option value="@pm" selected="@(Model.Pm == pm)">@pm</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="f-lider">Líder</label>
                    <select name="Lider" id="f-lider" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var lider in Model.Lideres)
                        {
                            <option value="@lider" selected="@(Model.Lider == lider)">@lider</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="f-sistema">Sistema impactado</label>
                    <select name="SistemaId" id="f-sistema" class="form-select" asp-items="@(new SelectList(Model.Sistemas, "Id", "Nombre"))">
                        <option value="">Todos</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="text-secondary mb-0">@Model.Proyectos.Count iniciativa(s) encontradas.</p>
    <a href="@Url.Page("/Portafolio/Index", null, new { forzar = true, Model.InstitucionId, Model.Tipo, Model.Estado, Model.RecursoQAId, Model.Pm, Model.Lider, Model.SistemaId })"
       class="btn btn-sm btn-outline-secondary" title="Actualizar el avance desde Squash TM ahora">&#8635; Actualizar</a>
</div>

<div id="vista-tarjetas" class="portafolio-grid">
    @foreach (var p in Model.Proyectos)
    {
        var avanceTexto = p.Avance.ToString("0.#");
        <div class="card proyecto-card">
            <div class="card-body d-flex flex-column gap-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h2 class="card-title mb-0">@p.Nombre</h2>
                    <span class="badge @p.Estado.BadgeClase() flex-shrink-0">@p.Estado.Texto()</span>
                </div>
                <div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-secondary">Avance</span>
                        <span class="proyecto-avance">@avanceTexto%</span>
                    </div>
                    <div class="progress progress-sm" role="progressbar" aria-label="Avance de @p.Nombre" aria-valuenow="@p.Avance" aria-valuemin="0" aria-valuemax="100" title="Avance @p.Avance%">
                        <div class="progress-bar" style="width:@(p.Avance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
                <dl class="proyecto-datos">
                    <dt>Institución</dt><dd>@p.Institucion?.Nombre · @p.Tipo.Texto()</dd>
                    <dt>PM</dt><dd>@(p.PM ?? "—")</dd>
                    <dt>Líder</dt><dd>@(p.Lider ?? "—")</dd>
                    <dt>Periodo</dt><dd>@p.FechaInicio.ToString("dd/MM/yyyy") - @p.FechaFin.ToString("dd/MM/yyyy")</dd>
                    <dt>Recursos QA</dt>
                    <dd>
                        @if (p.Asignaciones.Any())
                        {
                            @string.Join(", ", p.Asignaciones.GroupBy(a => a.RecursoQAId).Select(g => $"{g.First().RecursoQA?.NombreCompleto} ({g.Max(a => a.Porcentaje):0.#}%)"))
                        }
                        else { <span class="text-secondary">Sin asignar</span> }
                    </dd>
                </dl>
                <a asp-page="/Portafolio/Detalle" asp-route-id="@p.Id" class="btn btn-outline-primary mt-auto" aria-label="Ver detalle de @p.Nombre">Ver detalle</a>
            </div>
        </div>
    }
    @if (!Model.Proyectos.Any())
    {
        <div class="card" style="grid-column: 1 / -1">
            <div class="card-body">
                <div class="empty">
                    <p class="empty-title">No hay iniciativas que coincidan con los filtros seleccionados.</p>
                    @if (hayFiltros)
                    {
                        <p class="empty-subtitle text-secondary">Prueba con otros valores o quita los filtros aplicados.</p>
                        <div class="empty-action"><a asp-page="/Portafolio/Index" class="btn btn-outline-secondary">Limpiar filtros</a></div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div id="vista-tabla" class="card d-none">
    <div class="table-responsive">
        <table class="table table-striped table-hover table-vcenter card-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Institución</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>PM</th>
                    <th>Líder</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Avance</th>
                    <th>Recursos QA</th>
                    <th><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Proyectos)
                {
                    <tr>
                        <td class="fw-medium">@p.Nombre</td>
                        <td>@p.Institucion?.Nombre</td>
                        <td>@p.Tipo.Texto()</td>
                        <td><span class="badge @p.Estado.BadgeClase()">@p.Estado.Texto()</span></td>
                        <td>@(p.PM ?? "—")</td>
                        <td>@(p.Lider ?? "—")</td>
                        <td class="text-nowrap">@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">@p.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap fw-medium">@p.Avance%</td>
                        <td>
                            @{ var recursos = p.Asignaciones.Select(a => a.RecursoQA?.NombreCompleto).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().ToList(); }
                            @if (recursos.Any())
                            {
                                <div class="chips-recursos">
                                    @foreach (var r in recursos) { <span class="chip-recurso">@r</span> }
                                </div>
                            }
                            else { <span>—</span> }
                        </td>
                        <td><a asp-page="/Portafolio/Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" aria-label="Ver detalle de @p.Nombre">Detalle</a></td>
                    </tr>
                }
                @if (!Model.Proyectos.Any())
                {
                    <tr>
                        <td colspan="11" class="text-center text-secondary py-4">No hay iniciativas que coincidan con los filtros seleccionados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/portafolio-vista.js" asp-append-version="true"></script>
}
