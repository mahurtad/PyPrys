<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portafolio QA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PortafolioQA.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Portafolio/Index">Portafolio QA</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Portafolio/Index">Portafolio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="planDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Planificación
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="planDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Planificacion/Gantt">Gantt</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Planificacion/Calendario">Calendario</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Planificacion/Capacidad">Capacidad QA</a></li>
                            </ul>
                        </li>
                        @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Editor))
                        {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Administración
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Instituciones/Index">Instituciones</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/RecursosQA/Index">Recursos QA</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Sistemas/Index">Sistemas / periféricos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Proyectos/Index">Proyectos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Asignaciones/Index">Asignaciones</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Hitos/Index">Hitos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Feriados/Index">Feriados</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Ausencias/Index">Ausencias</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Integraciones/Index">Integraciones</a></li>
                                @if (User.IsInRole(Roles.Administrador))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Usuarios/Index">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Setup/Index">Conexión a la base de datos</a></li>
                                }
                            </ul>
                        </li>
                        }
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="text-muted">@User.Identity.Name</span>
                            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-page="/Account/CambiarPassword">Contraseña</a>
                            <form method="post" asp-area="" asp-page="/Account/Logout" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-dark">Salir</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            &copy; 2026 - Portafolio QA - Versión interna
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
