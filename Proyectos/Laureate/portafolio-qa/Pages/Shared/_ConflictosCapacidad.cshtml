@model List<PortafolioQA.Services.ConflictoCapacidad>
@{
    var puedeForzar = ViewData["PuedeForzar"] as bool? ?? false;
}
@if (Model.Any())
{
    <div class="alert alert-warning">
        <strong>Sobreasignación detectada.</strong> Con esta asignación se supera la capacidad del recurso:
        <ul class="mb-2 mt-2">
            @foreach (var c in Model)
            {
                <li>
                    <strong>@c.Recurso</strong>: del @c.Inicio.ToString("dd/MM/yyyy") al @c.Fin.ToString("dd/MM/yyyy")
                    pide @c.Solicitado.ToString("0.##")%, pero su carga existente llega a @c.ExistenteMaximo.ToString("0.##")% de @c.Capacidad.ToString("0.##")% de capacidad
                    (máximo asignable en ese tramo: @c.LibreMinimo.ToString("0.##")%).
                    @if (c.Ausencias.Any())
                    {
                        <span class="d-block small"><strong>Ausencia registrada:</strong> @string.Join("; ", c.Ausencias) (no disponible ese día).</span>
                    }
                    @if (c.InicioSugerido is not null)
                    {
                        <span class="d-block small">Primer día en que cabe esta asignación después del tramo: <strong>@c.InicioSugerido.Value.ToString("dd/MM/yyyy")</strong>.</span>
                    }
                    @if (c.Proyectos.Any())
                    {
                        <span class="d-block small text-muted">Proyectos que ocupan su tiempo: @string.Join(", ", c.Proyectos)</span>
                    }
                </li>
            }
        </ul>
        @if (puedeForzar)
        {
            <button type="submit" name="Forzar" value="true" class="btn btn-sm btn-warning">Guardar de todas formas</button>
            <span class="small ms-2">Solo el rol Administrador puede forzar la sobreasignación.</span>
        }
        else
        {
            <span class="small">Ajusta el porcentaje o las fechas. Solo un Administrador puede guardar con sobreasignación.</span>
        }
    </div>
}
