@page
@model PortafolioQA.Pages.Account.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h1 class="h3 mb-3">Cambiar contraseña</h1>
<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Entrada.Actual" class="form-label">Contraseña actual</label>
                <input asp-for="Entrada.Actual" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Entrada.Actual" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Entrada.Nueva" class="form-label">Nueva contraseña</label>
                <input asp-for="Entrada.Nueva" class="form-control" autocomplete="new-password" />
                <div class="form-text">Mínimo 10 caracteres, con mayúscula, minúscula y número.</div>
                <span asp-validation-for="Entrada.Nueva" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Entrada.Confirmacion" class="form-label">Confirmar nueva contraseña</label>
                <input asp-for="Entrada.Confirmacion" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Entrada.Confirmacion" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="/Portafolio/Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
